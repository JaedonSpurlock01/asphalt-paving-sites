{
  "name": "asphalt-paving-pocatello",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "main": "../../dist/_worker.js/index.js",
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS"
  },
  "vars": {
    "TRACER_FORMS_URL": "https://tracer-staging.jaedonaspurlock.workers.dev/api/forms"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
